---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  title="Заметки · didaktik"
  description="Разборы из практики: платформы, доставка, эксплуатация."
>
  <div class="wrap page doc">
    <p class="margin"><b>Заметки</b>{notes.length > 0 && `${notes.length} шт.`}</p>
    <div class="main">
    <h1 class="page-title">Разборы из практики</h1>
    <p class="lead">Что работает, что нет и почему. С командами, конфигами и цифрами.</p>
    {notes.length === 0 ? (
      <p class="mono empty">Пока пусто. Первые заметки в работе.</p>
    ) : (
      <ul class="list">
        {notes.map((n) => (
          <li class="item">
            <time class="mono" datetime={n.data.date.toISOString()}>
              {n.data.date.toLocaleDateString('ru-RU', { dateStyle: 'long' })}
            </time>
            <div>
              <a class="title" href={`/notes/${n.id}/`}>{n.data.title}</a>
              <p class="desc">{n.data.description}</p>
              {n.data.tags.length > 0 && <p class="mono tags">{n.data.tags.join(' · ')}</p>}
            </div>
          </li>
        ))}
      </ul>
    )}
    </div>
  </div>
</Base>

<style>
  .empty { margin-top: 40px; }
  .list { list-style: none; margin: 48px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .item time { padding-top: 4px; }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 192px) minmax(0, 1fr);
    gap: 32px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .title { font-family: var(--serif); font-size: 20px; line-height: 28px; }
  .desc { margin: 8px 0 0; color: var(--muted); font-size: 16px; line-height: 24px; max-width: 62ch; }
  .tags { margin: 10px 0 0; }
  @media (max-width: 640px) { .item { grid-template-columns: minmax(0, 1fr); gap: 6px; } }
</style>
