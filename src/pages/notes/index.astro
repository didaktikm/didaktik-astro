---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Заметки · didaktik"
  description="Разборы из практики: платформы, доставка, эксплуатация."
>
  <div class="page wrap" data-reveal>
    <div class="top">
      <h1 class="page-title" data-rv="0">Заметки из&nbsp;практики</h1>
      <p class="page-lead" data-rv="1">Что работает, что нет и&nbsp;почему. С&nbsp;командами, конфигами и&nbsp;цифрами.</p>
    </div>
    {notes.length === 0 ? (
      <div class="empty" data-rv="2">
        <p data-rv="3">Первые заметки ещё в&nbsp;работе: про общий Caddy для нескольких сайтов и&nbsp;деплой образа из&nbsp;GHCR по&nbsp;тегу.</p>
        <p data-rv="4">Пока можно открыть консоль и&nbsp;набрать <code>help</code> или посмотреть <a class="link" href="/#audit">отчёт об&nbsp;аудите этого сайта</a>.</p>
      </div>
    ) : (
      <ul class="list">
        {notes.map((n, i) => (
          <li data-rv={Math.min(i, 5) + 2}>
            <a class="title" href={`/notes/${n.id}/`}>{n.data.title}</a>
            <p class="desc">{n.data.description}</p>
            <p class="meta"><time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>{n.data.tags.length > 0 && `, ${n.data.tags.join(', ')}`}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--margin); align-items: end; }
  .top .page-lead { margin: 0; }
  .empty { margin-top: 72px; padding: 40px; background: var(--surface); max-width: 760px; }
  .empty p + p { margin-top: 1em; }
  code { font-family: var(--mono); font-size: 0.8em; padding: 2px 6px; background: var(--bg); }
  .list { margin: 72px 0 0; padding: 0; list-style: none; display: grid; gap: 48px; }
  .title { font-size: var(--step-head); font-weight: 400; line-height: 1.05; letter-spacing: -0.03em; transition: color var(--t-hover) ease; }
  .title:hover { text-decoration: underline; text-decoration-thickness: 0.05em; text-underline-offset: 0.15em; }
  .desc { margin-top: 12px; max-width: 60ch; }
  .meta { margin-top: 8px; font-size: var(--step-small); color: var(--muted); }
  @media (max-width: 899px) { .top { grid-template-columns: minmax(0, 1fr); } .top .page-lead { margin-top: 24px; } .empty { padding: 24px; } }
</style>
