---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date;
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 180));
---
<Base
  title={`${entry.data.title} · didaktik`}
  description={entry.data.description}
  type="article"
>
  <article class="wrap page doc">
    <div class="margin">
      <p><b><time datetime={date.toISOString()}>{date.toLocaleDateString('ru-RU', { dateStyle: 'long' })}</time></b>{minutes} мин чтения</p>
      {entry.data.tags.length > 0 && <p>{entry.data.tags.join(' · ')}</p>}
      <p><a href="/notes/">← все заметки</a></p>
    </div>
    <div class="main">
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <div class="prose body">
      <Content />
    </div>
    <a class="back" href="/notes/">← Все заметки</a>
    </div>
  </article>
</Base>

<style>
  .body { margin-top: 48px; }
</style>
