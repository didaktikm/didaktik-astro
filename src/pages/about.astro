---
import Base from '../layouts/Base.astro';
import { contactEmail } from '../lib/build';

const facts = [
  { k: 'Город', v: 'Москва' },
  { k: 'Опыт', v: 'больше 20 лет в инфраструктуре' },
  { k: 'Сейчас', v: 'руковожу DevOps-департаментом' },
  { k: 'Должность', v: 'руководитель центра сопровождения процессов разработки ПО' },
  { k: 'Направления', v: 'аудит платформ, DevOps, архитектура, безопасность <span class="nw">ИИ-агентов</span>' },
];

const path = [
  {
    years: '2005–2010',
    text: 'Создал IT-подразделение компании с нуля и построил филиальную сеть: около десяти филиалов и больше двухсот рабочих мест в головном офисе.',
  },
  {
    years: '2010–2019',
    text: 'Корпоративная сеть и серверная с нуля (256 портов), перевод физических серверов в виртуализацию: VMware ESXi, затем Proxmox. Мониторинг на Zabbix, базовые сервисы: DNS, LDAP, почта.',
  },
  {
    years: '2019–2021',
    text: 'Перешёл в DevOps: сопровождение полного цикла разработки, поддержка инфраструктуры, мониторинг сервисов.',
  },
  {
    years: '2021–2022',
    text: 'Участвовал в создании озера данных на Arenadata Hadoop и ETL на Spark для банка из топ-5 России. Сформировал с нуля DevOps-направление в департаменте данных и настроил CI/CD.',
  },
  {
    years: '2022 — сейчас',
    text: 'Выстроил DevOps в компании с нуля и создал DevOps-департамент. Сократили парк на 300+ виртуальных серверов (расходы на инфраструктуру ниже на 40–50%), перенесли ключевые сервисы в Kubernetes, перевели доставку на GitLab CI и GitOps, мониторинг на VictoriaMetrics. Отвечаю за развитие DevOps-практик, процессы разработки и доставки, бюджет инфраструктуры и облачные платформы.',
  },
];
---
<Base
  title="Обо мне · Павел, DevOps и архитектура инфраструктуры"
  description="Больше двадцати лет в инфраструктуре, руковожу DevOps-департаментом в Москве. Аудит платформ, DevOps, архитектура и безопасность ИИ-агентов."
>
  <div class="wrap page">
    <p class="eyebrow">Обо мне</p>
    <h1 class="page-title">Павел, руководитель <span class="nw">DevOps-департамента</span> и консультант по инфраструктуре</h1>

    <div class="layout">
      <div class="prose">
        <p>Больше двадцати лет занимаюсь инфраструктурой: от IT-подразделения и корпоративной сети с нуля до собственного DevOps-департамента, которым сейчас руковожу в Москве.</p>
        <p>Как консультант помогаю командам, у которых уже есть прод: провожу аудит платформ, проектирую инфраструктуру и налаживаю доставку. Отдельное направление — безопасность ИИ-агентов в разработке: как дать Claude Code или Copilot доступ к репозиторию и не потерять контроль над данными.</p>
        <p>Параллельно с основной работой веду собственные исследования и обучаю команды. В заметках пишу о том, что проверил на практике.</p>

        <h2>Путь</h2>
        <ol class="timeline">
          {path.map((item) => (
            <li>
              <span class="years mono">{item.years}</span>
              <span class="what">{item.text}</span>
            </li>
          ))}
        </ol>

        <h2>Когда прод не горит</h2>
        <p>Мотоциклы люблю с детства. Сейчас у меня Ducati Multistrada V4S: на ней хорошо думается, а до ближайшего алерта всегда успеваешь доехать.</p>
        <figure class="quote">
          <blockquote>Настоящий мотоцикл, над которым вы работаете, — это вы сами.</blockquote>
          <figcaption>Роберт Пирсиг, «Дзен и искусство ухода за мотоциклом»</figcaption>
        </figure>
        <p>Второе увлечение — штанга. В зале, как и в инфраструктуре, спорить бесполезно: вес на грифе либо поднят, либо нет.</p>
        <figure class="quote">
          <blockquote>Железо никогда не лжёт. Двести фунтов — это всегда двести фунтов.</blockquote>
          <figcaption>Генри Роллинз, эссе «Железо и душа»</figcaption>
        </figure>
      </div>

      <aside class="card" aria-label="Коротко">
        <dl>
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.k}</dt>
              <dd set:html={f.v} />
            </div>
          ))}
        </dl>
        <div class="contact">
          <a class="btn btn-primary" href="https://t.me/didaktik" target="_blank" rel="noopener">Написать в Telegram</a>
          <a class="mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    margin-top: 48px;
  }
  .card {
    align-self: start;
    padding: 24px;
    border-radius: 12px;
    background: var(--panel);
  }
  .prose .timeline { list-style: none; margin: 24px 0 0; padding: 0; }
  .prose .timeline li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    padding: 16px 0;
    border-top: 1px solid var(--line-soft);
    font-size: 16px;
    line-height: 24px;
  }
  .prose .timeline li:last-child { border-bottom: 1px solid var(--line-soft); }
  .years { color: var(--teal); white-space: nowrap; }
  .what { color: var(--fg); }
  @media (min-width: 768px) {
    .prose .timeline li { grid-template-columns: 128px minmax(0, 1fr); gap: 24px; }
    .years { padding-top: 2px; }
  }
  .prose .quote { margin: 24px 0; }
  .prose .quote blockquote { margin: 0; font-size: 20px; line-height: 28px; color: var(--fg); }
  .prose .quote figcaption { margin-top: 8px; padding-left: 22px; font-size: 14px; line-height: 20px; color: var(--faint); }
  dl { margin: 0; }
  :global(.nw) { white-space: nowrap; }
  .fact { padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
  .fact:first-child { padding-top: 0; }
  dt { font-size: 14px; line-height: 20px; color: var(--faint); }
  dd { margin: 4px 0 0; font-size: 16px; line-height: 24px; }
  .contact { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
  .contact .btn { justify-content: center; }
  .mail { font-size: 14px; line-height: 20px; color: var(--muted); text-align: center; }
  .mail:hover { color: var(--teal); }
  @media (min-width: 960px) {
    .layout { grid-template-columns: minmax(0, 1fr) 336px; gap: 64px; }
    .card { position: sticky; top: 24px; }
  }
</style>
