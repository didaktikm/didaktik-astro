---
import Base from '../layouts/Base.astro';
const rows = [
  { k: 'Влияние', v: 'Вы и, возможно, ещё один человек.' },
  { k: 'Причина', v: 'Ссылка устарела, в адресе опечатка или страницу так и не написали.' },
  { k: 'Что делать', v: 'Вернуться на главную или открыть консоль и набрать ls notes.' },
  { k: 'Задачи на потом', v: 'Никаких. Это не DNS, мы проверили.' },
];
---
<Base title="404 · didaktik" description="Страница не найдена.">
  <div class="page wrap" data-reveal>
    <div class="grid">
      <div>
        <h1 class="page-title" data-rv="0">404. Такой страницы нет</h1>
        <p class="page-lead" data-rv="1">Разбор инцидента, как положено, без поиска виноватых.</p>
        <p data-rv="2"><a class="btn go" href="/">На главную</a></p>
      </div>
      <dl class="pm">
        {rows.map((r, i) => <div data-rv={i + 3}><dt>{r.k}</dt><dd>{r.v}</dd></div>)}
      </dl>
    </div>
  </div>
</Base>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: calc(var(--margin) * 2); align-items: end; min-height: 52vh; }
  .go { margin-top: 40px; }
  .pm { margin: 0; padding: 32px; background: var(--surface); display: grid; gap: 20px; }
  .pm dt { font-size: var(--step-small); color: var(--muted); }
  .pm dd { margin: 4px 0 0; }
  @media (max-width: 899px) { .grid { grid-template-columns: minmax(0, 1fr); min-height: 0; } .pm { padding: 24px; } }
</style>
