---
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

type Item = { name: string; detail: string; href?: string };
const parts: { id: string; title: string; items: Item[] }[] = [
  {
    id: 'process',
    title: 'Как работаю',
    items: [
      { name: 'Знакомство', detail: 'Переписка или созвон, Telegram или почта. Отвечаю, могу ли помочь.' },
      { name: 'Аудит', detail: 'Доступ на чтение к коду, CI/CD, мониторингу и облаку. Результат: находки с доказательствами.' },
      { name: 'Отчёт и план', detail: 'Разбор с вашей командой на созвоне. Исправления оцениваются по цене.' },
      { name: 'Исправления', detail: 'Вместе или силами вашей команды, в вашей инфраструктуре, по плану из отчёта.' },
    ],
  },
  {
    id: 'teach',
    title: 'Обучение',
    items: [
      { name: 'Воркшоп по CI/CD', detail: 'Для команды, на вашем репозитории. Результат: отчёт с находками.' },
      { name: 'ИИ-ассистенты без утечек', detail: 'Для команды, на вашем репозитории. Результат: права, политики, журнал действий.' },
      { name: 'Менторство', detail: 'Один на один, онлайн. Разбираем ваши задачи.' },
    ],
  },
];
if (notes.length) {
  parts.push({
    id: 'notes',
    title: 'Заметки',
    items: notes.map((n) => ({
      name: n.data.title,
      detail: `${n.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}. ${n.data.tags.join(', ')}`,
      href: `/notes/${n.id}/`,
    })),
  });
}
---
<section id="programme" class="prog wrap" data-reveal>
  {parts.map((p, pi) => (
    <div class="part" id={p.id} data-rv={pi}>
      <h2 class="head">{p.title}</h2>
      <ul class="items">
        {p.items.map((it) => (
          <li>
            <p class="name">{it.href ? <a class="link" href={it.href}>{it.name}</a> : it.name}</p>
            <p class="detail">{it.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  ))}
  <p class="note" data-rv="3">Формат и сроки обсуждаем под задачу. Учу тому, что сам применяю в&nbsp;продакшене.</p>
</section>

<style>
  .prog { padding-top: var(--gap-section); }
  .part { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--margin) calc(var(--margin) * 2); align-items: start; }
  .part + .part { margin-top: var(--gap-section); }
  .items { margin: 0; padding: 0; list-style: none; display: grid; gap: 28px; }
  .name { font-size: var(--step-lead); line-height: 1.3; font-weight: 500; }
  .detail { margin-top: 4px; max-width: 60ch; color: var(--muted); }
  .note { margin-top: 56px; color: var(--muted); max-width: 52ch; }

  @media (max-width: 899px) {
    .part { grid-template-columns: minmax(0, 1fr); }
    .items { gap: 22px; }
  }
</style>
