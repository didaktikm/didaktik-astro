---
interface Props { hasNotes: boolean }
const { hasNotes } = Astro.props;
const path = Astro.url.pathname;
const home = path === '/' ? '' : '/';
const current = (p: string): 'page' | undefined => (path.startsWith(p) ? 'page' : undefined);
const links: { href: string; label: string; current?: 'page' }[] = [
  { href: `${home}#work`, label: 'Услуги' },
  { href: `${home}#audit`, label: 'Отчёт' },
  { href: `${home}#path`, label: 'Путь' },
  { href: '/about/', label: 'Обо мне', current: current('/about') },
  ...(hasNotes ? [{ href: '/notes/', label: 'Заметки', current: current('/notes') }] : []),
];
---
<header class="top wrap">
  <a class="mark" href="/" aria-label="didaktik, на главную">didaktik</a>

  <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="site-nav" hidden>Меню</button>

  <nav class="nav" id="site-nav" aria-label="Основная навигация">
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href} aria-current={l.current}>{l.label}</a></li>
      ))}
    </ul>
    <div class="tools">
      <button type="button" class="tool" data-console-open aria-controls="console" aria-expanded="false">Консоль</button>
      <button type="button" class="tool" data-theme-toggle aria-label="Переключить тему">
        <span data-theme-label>Светлая тема</span>
      </button>
    </div>
  </nav>
</header>

<script>
  // Тема: переключатель с запоминанием
  const root = document.documentElement;
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));
  const paint = () => {
    const dark = root.dataset.theme !== 'light';
    for (const t of toggles) {
      const label = t.querySelector('[data-theme-label]');
      if (label) label.textContent = dark ? 'Светлая тема' : 'Тёмная тема';
      t.setAttribute('aria-label', dark ? 'Включить светлую тему' : 'Включить тёмную тему');
    }
    const bg = getComputedStyle(root).getPropertyValue('--bg').trim();
    document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', bg));
  };
  for (const t of toggles) {
    t.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      paint();
    });
  }
  paint();

  // Мобильное меню: без скрипта ссылки просто стоят в строке под логотипом
  const btn = document.querySelector<HTMLButtonElement>('#menu-btn');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (btn && nav) {
    btn.hidden = false;
    nav.classList.add('js');
    const set = (v: boolean) => {
      nav.classList.toggle('open', v);
      btn.setAttribute('aria-expanded', String(v));
      btn.textContent = v ? 'Закрыть' : 'Меню';
      root.classList.toggle('menu-open', v);
    };
    btn.addEventListener('click', () => set(!nav.classList.contains('open')));
    nav.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('a') || el.closest('[data-console-open]')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); btn.focus(); }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', (m) => { if (m.matches) set(false); });
  }
</script>

<style>
  .top {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    min-height: 88px;
    font-size: 16px;
    line-height: 24px;
  }
  .mark { font-size: var(--step-lead); font-weight: 500; letter-spacing: -0.01em; }
  .nav { display: flex; align-items: center; gap: 40px; }
  .links { display: flex; gap: 28px; margin: 0; padding: 0; list-style: none; }
  .tools { display: flex; gap: 20px; }
  .links a, .tool {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    transition: color var(--t-hover) ease;
  }
  .links a:hover, .tool:hover, .links a[aria-current='page'] { color: var(--ink); }
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-ui) var(--ease-out);
  }
  .links a:hover::after, .links a[aria-current='page']::after { transform: scaleX(1); }
  .tool { padding: 0; border: 0; background: none; cursor: pointer; }

  .menu-btn {
    display: none;
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    font-weight: 500;
    cursor: pointer;
  }

  @media (max-width: 1099px) {
    .nav { gap: 28px; }
    .links { gap: 20px; }
  }

  @media (max-width: 899px) {
    .top { flex-wrap: wrap; }
    .menu-btn:not([hidden]) { display: block; position: relative; z-index: 2; }
    .nav:not(.js) { width: 100%; flex-wrap: wrap; gap: 8px 24px; }
    .nav:not(.js) .links { flex-wrap: wrap; gap: 4px 20px; }
    .nav.js {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      gap: 32px;
      padding: 104px max(var(--margin), env(safe-area-inset-right, 0px)) max(32px, env(safe-area-inset-bottom, 0px)) max(var(--margin), env(safe-area-inset-left, 0px));
      background: var(--bg);
      visibility: hidden;
      opacity: 0;
      transition: opacity var(--t-ui) ease, visibility 0s linear var(--t-ui);
    }
    .nav.js.open { visibility: visible; opacity: 1; transition: opacity var(--t-ui) ease; }
    .nav.js .links { flex-direction: column; gap: 4px; }
    .nav.js .links a {
      min-height: 56px;
      font-size: var(--step-head);
      font-weight: 300;
      letter-spacing: -0.03em;
      color: var(--ink);
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
    }
    .nav.js .links a::after { display: none; }
    .nav.js.open .links a { opacity: 1; transform: none; }
    .nav.js.open li:nth-child(2) a { transition-delay: 50ms; }
    .nav.js.open li:nth-child(3) a { transition-delay: 100ms; }
    .nav.js.open li:nth-child(4) a { transition-delay: 150ms; }
    .nav.js.open li:nth-child(5) a { transition-delay: 200ms; }
    .nav.js .tools { flex-direction: column; gap: 4px; }
    .nav.js .tool { font-size: var(--step-lead); color: var(--ink); }
    :global(html.menu-open) { overflow: hidden; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav.js .links a { transform: none; }
  }
</style>
