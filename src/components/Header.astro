---
interface Props { hasNotes: boolean }
const { hasNotes } = Astro.props;
const path = Astro.url.pathname;
const home = path === '/' ? '' : '/';
const current = (p: string) => (path.startsWith(p) ? 'page' : undefined);
---
<header class="top wrap">
  <a class="logo" href="/" aria-label="didaktik, на главную">didaktik<span aria-hidden="true">_</span></a>
  <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="site-nav" aria-label="Меню" hidden>
    <span class="bars" aria-hidden="true"><span></span><span></span></span>
  </button>
  <nav class="nav" id="site-nav" aria-label="Основная навигация">
    <a href={`${home}#work`}>Услуги</a>
    <a href={`${home}#process`}>Как работаю</a>
    <a href={`${home}#audit`}>Пример отчёта</a>
    <a href={`${home}#teach`}>Обучение</a>
    {hasNotes && <a href="/notes/" aria-current={current('/notes')}>Заметки</a>}
    <a href="/about/" aria-current={current('/about')}>Обо мне</a>
    <a class="cta" href="https://t.me/didaktik" target="_blank" rel="noopener">Написать</a>
  </nav>
</header>

<script>
  // Мобильное меню: без скрипта ссылки просто переносятся на вторую строку
  const btn = document.querySelector<HTMLButtonElement>('#menu-btn');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (btn && nav) {
    btn.hidden = false;
    nav.classList.add('js');
    const set = (v: boolean) => {
      nav.classList.toggle('open', v);
      btn.setAttribute('aria-expanded', String(v));
      document.documentElement.classList.toggle('menu-open', v);
    };
    btn.addEventListener('click', () => set(!nav.classList.contains('open')));
    nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); btn.focus(); }
    });
    matchMedia('(min-width: 768px)').addEventListener('change', (m) => { if (m.matches) set(false); });
  }
</script>

<style>
  .top {
    position: relative;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 24px;
  }
  .logo { font-family: var(--mono); font-size: 14px; line-height: 20px; color: var(--fg); }
  .nav { align-items: center; }
  .logo span { color: var(--teal); }
  .nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px 24px; font-size: 14px; line-height: 20px; }
  .nav a { color: var(--muted); padding-block: 4px; }
  .nav a:hover { color: var(--fg); }
  .nav a[aria-current='page'] { color: var(--fg); text-decoration: underline; text-decoration-color: var(--teal); text-underline-offset: 8px; text-decoration-thickness: 1px; }
  .nav a.cta {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--teal);
    color: var(--teal);
    font-weight: 600;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .nav a.cta:hover { background: var(--teal); color: var(--on-teal); }

  .menu-btn {
    display: none;
    position: relative;
    z-index: 2;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
  }
  .menu-btn[hidden] { display: none; }
  .bars { position: relative; display: block; width: 16px; height: 8px; margin: 0 auto; }
  .bars span {
    position: absolute;
    left: 0;
    width: 16px;
    height: 1.5px;
    background: var(--fg);
    transition: transform 0.5s var(--ease);
  }
  .bars span:first-child { top: 0; }
  .bars span:last-child { bottom: 0; }
  .menu-btn[aria-expanded='true'] .bars span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .bars span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  @media (max-width: 767px) {
    .menu-btn:not([hidden]) { display: block; }
    .nav.js {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0;
      padding: 96px max(var(--gutter), env(safe-area-inset-right, 0px)) 48px max(var(--gutter), env(safe-area-inset-left, 0px));
      background: oklch(0.155 0.012 230 / 0.97);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.3s var(--ease), visibility 0s linear 0.3s;
    }
    .nav.js.open { visibility: visible; opacity: 1; transition: opacity 0.3s var(--ease); }
    .nav.js a {
      padding: 16px 0;
      font-weight: 600;
      font-size: 24px;
      line-height: 32px;
      color: var(--fg);
      border-top: 1px solid var(--line-soft);
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
    }
    .nav.js a.cta { color: var(--teal); border: 0; border-top: 1px solid var(--line-soft); border-radius: 0; padding: 16px 0; background: none; }
    .nav.js.open a { opacity: 1; transform: none; }
    .nav.js.open a:nth-child(2) { transition-delay: 60ms; }
    .nav.js.open a:nth-child(3) { transition-delay: 120ms; }
    .nav.js.open a:nth-child(4) { transition-delay: 180ms; }
    .nav.js.open a:nth-child(5) { transition-delay: 240ms; }
    .nav.js.open a:nth-child(6) { transition-delay: 300ms; }
    .nav.js.open a:nth-child(7) { transition-delay: 340ms; }
    :global(html.menu-open) { overflow: hidden; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav.js a { transform: none !important; }
    .bars span { transition: none; }
  }
</style>
