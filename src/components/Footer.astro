---
import { buildSha, buildDate, contactEmail } from '../lib/build';
const year = new Date().getFullYear();
---
<footer class="foot wrap">
  <div class="row">
    <p>© {year} Павел, Москва</p>
    <p class="links">
      <a class="link" href="https://t.me/didaktik" target="_blank" rel="noopener">Telegram</a>
      <a class="link" href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
  </div>
  <p class="build">Сборка {buildSha} от {buildDate}. <span data-page-weight>Вес страницы считается…</span> Без трекеров и cookies.</p>
  <p class="name" aria-hidden="true"><span data-fit>didaktik</span></p>
</footer>

<script>
  // Реальный вес страницы по Resource Timing
  const el = document.querySelector<HTMLElement>('[data-page-weight]');
  const measure = () => {
    if (!el || !('performance' in window)) return;
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const res = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
    const bytes = (nav?.transferSize ?? 0) + res.reduce((sum, r) => sum + (r.transferSize || 0), 0);
    el.textContent = bytes > 0 ? `Передано ${Math.round(bytes / 1024)} КБ.` : 'Страница из кэша.';
  };
  if (document.readyState === 'complete') measure();
  else addEventListener('load', () => setTimeout(measure, 0), { once: true });

</script>

<style>
  .foot { margin-top: var(--gap-section); padding-top: 56px; padding-bottom: max(16px, env(safe-area-inset-bottom, 0px)); background: var(--surface); overflow: hidden; }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .build { margin-top: 16px; font-size: var(--step-small); color: var(--muted); max-width: none; }
  .name {
    margin: 40px 0 0;
    font-size: var(--step-lead);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
</style>
