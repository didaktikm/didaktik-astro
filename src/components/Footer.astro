---
import { buildSha, buildDate, contactEmail } from '../lib/build';
const year = new Date().getFullYear();
---
<footer class="foot wrap">
  <div class="row">
    <span>© {year} Павел · didaktik.dev · Москва</span>
    <span class="links">
      <a href="https://t.me/didaktik" target="_blank" rel="noopener">Telegram</a>
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
  <p class="mono build">сборка {buildSha} · {buildDate} · <span data-page-weight>— KB</span> · без трекеров и cookies</p>
</footer>

<script>
  // Реальный вес страницы по данным Resource Timing
  const el = document.querySelector<HTMLElement>('[data-page-weight]');
  const measure = () => {
    if (!el || !('performance' in window)) return;
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const res = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
    const bytes = (nav?.transferSize ?? 0) + res.reduce((sum, r) => sum + (r.transferSize || 0), 0);
    el.textContent = bytes > 0 ? `${Math.round(bytes / 1024)} KB передано` : 'из кэша';
  };
  if (document.readyState === 'complete') measure();
  else window.addEventListener('load', () => setTimeout(measure, 0), { once: true });
</script>

<style>
  .foot { margin-top: 96px; padding-block: 32px 96px; border-top: 1px solid var(--line); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; font-size: 14px; line-height: 20px; color: var(--muted); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .links a { color: var(--fg); }
  .links a:hover { color: var(--teal); }
  .build { margin: 16px 0 0; color: var(--faint); }
</style>
