---
const facts = [
  { value: '20+ лет', text: 'в инфраструктуре: сети, виртуализация, Kubernetes, платформы данных' },
  { value: 'Head of DevOps', text: 'руковожу DevOps-департаментом: прод, доставка, платформа' },
  { value: 'ИИ-агенты', text: 'безопасный доступ Claude Code и Copilot к репозиториям с данными' },
];
---
<section id="top" class="wrap hero">
  <p class="who">Павел · DevOps и архитектура инфраструктуры · Москва</p>
  <h1 class="title">Аудит и развитие инфраструктуры для&nbsp;команд, у&nbsp;которых уже есть прод</h1>
  <p class="lead">Разбираю, как платформа работает на самом деле, нахожу слабые места в сборке, доставке, наблюдаемости и доступах, оцениваю цену каждого и помогаю закрыть самые дорогие.</p>
  <div class="actions">
    <a href="https://t.me/didaktik" class="btn btn-primary" target="_blank" rel="noopener">Обсудить задачу в Telegram</a>
    <a href="#process" class="btn">Как строится работа</a>
  </div>

  <dl class="facts">
    {facts.map((f) => (
      <div class="fact">
        <dt>{f.value}</dt>
        <dd>{f.text}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .hero { padding-block: 64px 0; }
  .who { margin: 0; font-size: 16px; line-height: 24px; color: var(--teal); font-weight: 500; }
  .title {
    font-family: var(--text);
    font-weight: 600;
    font-size: 36px;
    line-height: 40px;
    letter-spacing: -0.025em;
    margin: 16px 0 0;
    max-width: 20ch;
  }
  .lead { font-size: 18px; line-height: 28px; color: var(--muted); max-width: 60ch; margin: 24px 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 80px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .fact { min-width: 0; }
  dt { font-size: 20px; line-height: 28px; font-weight: 600; letter-spacing: -0.01em; }
  dd { margin: 8px 0 0; font-size: 14px; line-height: 20px; color: var(--muted); max-width: 32ch; }

  @media (min-width: 768px) {
    .hero { padding-top: 96px; }
    .title { font-size: 48px; line-height: 1.08; }
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; }
  }
  @media (min-width: 1200px) {
    .title { font-size: 60px; line-height: 1.05; max-width: 24ch; }
  }
</style>
