---
import { audit, auditDate } from '../data/audit';

const dateLabel = new Date(auditDate).toLocaleDateString('ru-RU', { dateStyle: 'long' });
const examples = ['откат за минуту?', 'секреты в CI', 'кэш статики'];
const initial = 'что с CI и деплоем?';
---
<section id="audit" class="audit wrap" data-reveal>
  <div class="top" data-rv="0">
    <h2 class="name-h"><label for="audit-q">Отчёт об&nbsp;аудите этого сайта. Спросите его</label></h2>
    <p class="meta">{dateLabel}, {audit.length} проверок</p>
  </div>

  <div class="ask" data-ui data-rv="1">
    <input id="audit-q" class="q" type="text" value={initial} spellcheck="false" autocomplete="off" data-audit-q />
  </div>

  <div class="answer" data-ui data-rv="2" aria-live="polite" data-audit-answer>
    <ul class="rows" data-audit-rows>
      {audit.map((c, i) => (
        <li class="row" data-audit-row={i} data-hay={`${c.check} ${c.method} ${c.before} ${c.after} ${c.keywords}`.toLowerCase()}>
          <p class="check"><span>{c.check}</span><span class:list={['status', c.score]}>{c.label}</span></p>
          <p class="method">{c.method}</p>
          <dl class="ba">
            <div><dt>Было</dt><dd>{c.before}</dd></div>
            <div><dt>Стало</dt><dd>{c.after}</dd></div>
          </dl>
        </li>
      ))}
    </ul>
    <p class="none" data-audit-none hidden>В&nbsp;этом аудите такой проверки не&nbsp;было. В&nbsp;вашем, скорее всего, будет.</p>
  </div>

  <div class="examples" data-rv="3">
    {examples.map((e) => <button type="button" class="ex" data-audit-ex={e}>{e}</button>)}
    <button type="button" class="ex all" data-audit-all>все {audit.length} проверок</button>
  </div>
</section>

<script>
  const q = document.querySelector<HTMLInputElement>('[data-audit-q]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-audit-row]'));
  const none = document.querySelector<HTMLElement>('[data-audit-none]');
  if (q && rows.length && none) {
    // Совпадение по началу слова: «откат» найдёт «откатить», «секреты» найдёт «секрет»
    const stems = (s: string) =>
      s.toLowerCase().replace(/[^\p{L}\p{N}\s/-]/gu, ' ').split(/\s+/).filter((w) => w.length > 1 && !['и', 'в', 'с', 'на', 'по', 'за', 'не'].includes(w)).map((w) => w.slice(0, Math.max(3, Math.min(5, w.length - 1))));
    const show = (list: HTMLElement[]) => {
      rows.forEach((r) => { r.hidden = !list.includes(r); });
      none.hidden = list.length > 0;
    };
    const search = () => {
      const words = stems(q.value);
      if (!words.length) { show(rows); return; }
      const scored = rows
        .map((r) => ({ r, s: words.filter((w) => r.dataset.hay!.includes(w)).length }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 3)
        .map((x) => x.r);
      show(scored);
    };
    q.addEventListener('input', search);
    document.querySelectorAll<HTMLButtonElement>('[data-audit-ex]').forEach((b) =>
      b.addEventListener('click', () => { q.value = b.dataset.auditEx!; search(); }),
    );
    document.querySelector('[data-audit-all]')?.addEventListener('click', () => { q.value = ''; show(rows); q.focus(); });
    search();
  }
</script>

<style>
  .audit { padding-top: var(--gap-section); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 32px; }
  .name-h { font-size: var(--step-lead); font-weight: 500; letter-spacing: -0.01em; }
  .meta { font-size: var(--step-body); color: var(--muted); }

  .ask { position: relative; margin-top: 24px; }
  .q {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--step-head);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--ink);
    caret-color: var(--accent);
    outline: none;
  }
  .q:focus-visible { outline: none; box-shadow: inset 0 -4px 0 var(--accent); } /* taste-skill-ignore: полоса фокуса поля, не тень */

  .answer { margin-top: 40px; }
  .rows { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4px 32px; padding: 20px 24px; background: var(--surface); }
  .row[hidden] { display: none; }
  .check { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; font-size: 18px; line-height: 26px; font-weight: 500; grid-column: 1; }
  .method { grid-column: 1; font-size: 15px; line-height: 22px; color: var(--muted); }
  .status { font-weight: 400; font-size: 15px; color: var(--muted); }
  .status.pass { color: var(--ink); font-weight: 500; }
  .ba { grid-column: 2; grid-row: 1 / span 2; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 0; }
  .ba dt { font-size: 14px; line-height: 20px; color: var(--muted); }
  .ba dd { margin: 4px 0 0; font-size: 16px; line-height: 23px; }
  .none { padding: 20px 24px; background: var(--surface); font-size: 18px; }

  .examples { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 32px; }
  .ex {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--step-body);
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.2em;
    cursor: pointer;
    transition: color var(--t-hover) ease;
  }
  .ex:hover { color: var(--ink); }

  @media (max-width: 899px) {
    .answer { margin-top: 28px; }
    .row { grid-template-columns: minmax(0, 1fr); padding: 18px 16px; }
    .ba { grid-column: 1; grid-row: auto; margin-top: 10px; }
    .examples { gap: 8px; }
    .ex { padding: 0 16px; background: var(--surface); text-decoration: none; color: var(--ink); }
  }
  @media (max-width: 480px) { .ba { grid-template-columns: minmax(0, 1fr); gap: 10px; } }
</style>
