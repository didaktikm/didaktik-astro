---
import { audit, auditDate } from '../data/audit';

const fixed = audit.filter((c) => c.label === 'исправлено').length;
const okAsIs = audit.filter((c) => c.label === 'в норме').length;
const dateLabel = new Date(auditDate).toLocaleDateString('ru-RU', { dateStyle: 'long' });
---
<section id="audit" class="wrap section doc">
  <div class="margin">
    <p><b>§2</b>аудит</p>
    <p>{dateLabel}<br />исправлено {fixed}<br />в норме {okAsIs}</p>
  </div>
  <div class="main">
    <h2 class="h2">Аудит этого сайта</h2>
    <p class="intro">Чтобы было видно, как выглядит результат, я проверил собственный репозиторий didaktik-astro. Ниже реальные находки: как проверял, что было и что стало. Пришлите ссылку на свой проект, разберу так же.</p>

    <ol class="findings">
      {audit.map((c, i) => (
        <li class="finding" id={`f${i + 1}`}>
          <span class="mono num">{i + 1}</span>
          <div class="what">
            <h3>{c.check}</h3>
            <p class="mono method">{c.method}</p>
          </div>
          <div class="diff mono" role="group" aria-label="Было и стало">
            <p class="minus"><span class="sign" aria-hidden="true">−</span><span class="visually-hidden">Было: </span>{c.before}</p>
            <p class="plus"><span class="sign" aria-hidden="true">+</span><span class="visually-hidden">Стало: </span>{c.after}</p>
          </div>
          <span class:list={['mono', 'status', c.score]}>{c.label}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .findings { list-style: none; margin: 48px 0 0; padding: 0; }
  .finding {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 8px 16px;
    padding: 24px 0;
    border-top: 1px solid var(--line-soft);
    scroll-margin-top: 24px;
  }
  .finding:target { background: var(--teal-dim); }
  .num { color: var(--faint); }
  .what { min-width: 0; }
  h3 { margin: 0; font-size: 16px; line-height: 24px; font-weight: 600; }
  .method { margin: 4px 0 0; color: var(--faint); }
  .diff { grid-column: 2 / -1; min-width: 0; }
  .diff p { margin: 0; display: grid; grid-template-columns: 16px minmax(0, 1fr); }
  .minus { color: var(--faint); }
  .minus .sign { color: var(--faint); }
  .plus { color: var(--fg); margin-top: 4px; }
  .plus .sign { color: var(--teal); }
  .status { grid-column: 3; grid-row: 1; white-space: nowrap; color: var(--faint); }
  .status.pass { color: var(--teal); }
  .status.fail { color: var(--magenta); }

  @media (min-width: 1024px) {
    .finding { grid-template-columns: 24px minmax(0, 2fr) minmax(0, 3fr) 96px; gap: 24px; }
    .diff { grid-column: 3; grid-row: 1; }
    .status { grid-column: 4; text-align: right; }
  }
</style>
