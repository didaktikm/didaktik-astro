---
// Двадцать лет по резюме. Каждый рисунок — настоящее число из этого этапа, нарисованное единицами.
type Draw =
  | { kind: 'grid'; n: number; cols: number; off?: boolean }
  | { kind: 'split'; boxes: number; per: number }
  | { kind: 'ring'; n: number }
  | { kind: 'lake'; n: number }
  | { kind: 'bars'; values: number[] };

const moments: { years: string; text: string; figure: string; draw: Draw; gap: number }[] = [
  {
    years: '2005–2010',
    text: 'Создал IT-подразделение и филиальную сеть: около десяти филиалов и больше двухсот рабочих мест в головном офисе.',
    figure: '10 филиалов',
    draw: { kind: 'grid', n: 10, cols: 2 },
    gap: 96,
  },
  {
    years: '2010–2019',
    text: 'Корпоративная сеть и серверная с нуля. Мониторинг на Zabbix, DNS, LDAP, почта.',
    figure: '256 портов',
    draw: { kind: 'grid', n: 256, cols: 16 },
    gap: 136,
  },
  {
    years: 'Те же годы',
    text: 'Перевёл физические серверы в виртуализацию: сначала VMware ESXi, затем Proxmox.',
    figure: 'ESXi, затем Proxmox',
    draw: { kind: 'split', boxes: 4, per: 9 },
    gap: 80,
  },
  {
    years: '2019–2021',
    text: 'Перешёл в DevOps: полный цикл разработки, поддержка инфраструктуры, мониторинг сервисов.',
    figure: 'полный цикл',
    draw: { kind: 'ring', n: 12 },
    gap: 120,
  },
  {
    years: '2021–2022',
    text: 'Озеро данных на Arenadata Hadoop и ETL на Spark для банка из топ-5 России. DevOps-направление в департаменте данных с нуля.',
    figure: 'банк из топ-5',
    draw: { kind: 'lake', n: 360 },
    gap: 88,
  },
  {
    years: 'С 2022 года',
    text: 'Выстроил DevOps в компании с нуля и создал DevOps-департамент. Kubernetes, GitLab CI и GitOps, VictoriaMetrics.',
    figure: '300+ серверов выключено',
    draw: { kind: 'grid', n: 300, cols: 15, off: true },
    gap: 128,
  },
  {
    years: 'Итог для бюджета',
    text: 'Расходы на инфраструктуру после сокращения парка упали на 40–50%. Отвечаю за процессы, доставку и бюджет.',
    figure: '−40–50% расходов',
    draw: { kind: 'bars', values: [100, 55] },
    gap: 104,
  },
];

// SVG 400×500, единицы — квадраты. Цвет задаётся через currentColor и opacity.
const W = 400;
const H = 500;
const P = 40;
function shapes(d: Draw) {
  const out: { x: number; y: number; w: number; h: number; o: number }[] = [];
  if (d.kind === 'grid') {
    const rows = Math.ceil(d.n / d.cols);
    const cell = Math.min((W - 2 * P) / d.cols, (H - 2 * P - 60) / rows);
    const g = cell * (d.n > 50 ? 0.22 : 0.16);
    const x0 = (W - cell * d.cols) / 2;
    for (let i = 0; i < d.n; i++) {
      const c = i % d.cols;
      const r = Math.floor(i / d.cols);
      out.push({ x: x0 + c * cell + g / 2, y: P + r * cell + g / 2, w: cell - g, h: cell - g, o: d.off ? 0.28 : 1 });
    }
  } else if (d.kind === 'split') {
    const size = 140;
    const gap = 40;
    const x0 = (W - (size * 2 + gap)) / 2;
    const side = Math.sqrt(d.per);
    for (let b = 0; b < d.boxes; b++) {
      const bx = x0 + (b % 2) * (size + gap);
      const by = P + Math.floor(b / 2) * (size + gap);
      const cell = size / side;
      for (let i = 0; i < d.per; i++) {
        out.push({ x: bx + (i % side) * cell + 3, y: by + Math.floor(i / side) * cell + 3, w: cell - 6, h: cell - 6, o: b === 0 ? 0.28 : 1 });
      }
    }
  } else if (d.kind === 'ring') {
    const cx = W / 2;
    const cy = P + 150;
    const R = 130;
    const s = 34;
    for (let i = 0; i < d.n; i++) {
      const a = (i / d.n) * Math.PI * 2 - Math.PI / 2;
      out.push({ x: cx + Math.cos(a) * R - s / 2, y: cy + Math.sin(a) * R - s / 2, w: s, h: s, o: i === 0 ? 1 : 0.28 + (i / d.n) * 0.72 });
    }
  } else if (d.kind === 'lake') {
    const cols = 24;
    const cell = (W - 2 * P) / cols;
    const rows = Math.ceil(d.n / cols);
    const yBottom = H - P - 70;
    for (let i = 0; i < d.n; i++) {
      const c = i % cols;
      const r = Math.floor(i / cols);
      out.push({ x: P + c * cell + 2, y: yBottom - (r + 1) * cell + 2, w: cell - 4, h: cell - 4, o: r > rows - 4 ? 0.28 : 1 });
    }
  } else if (d.kind === 'bars') {
    const bw = 110;
    const gap = 60;
    const x0 = (W - (bw * 2 + gap)) / 2;
    const maxH = H - 2 * P - 70;
    d.values.forEach((v, i) => {
      const h = (v / 100) * maxH;
      out.push({ x: x0 + i * (bw + gap), y: P + (maxH - h), w: bw, h, o: i === 0 ? 0.28 : 1 });
    });
  }
  return out;
}
---
<section id="path" class="path" data-reveal>
  <div class="head-row wrap" data-rv="0">
    <h2 class="head">Двадцать лет в&nbsp;инфраструктуре</h2>
    <div class="nav-btns">
      <button type="button" class="sq" data-path-prev aria-label="Назад по годам">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      </button>
      <button type="button" class="sq" data-path-next aria-label="Вперёд по годам">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      </button>
    </div>
  </div>
  <div class="wrap" data-rv="1">
    <div class="progress" aria-hidden="true"><span data-path-bar></span></div>
  </div>

  <ol class="row" data-path-row tabindex="0" aria-label="Этапы карьеры, листаются вбок">
    {moments.map((m, i) => (
      <li class="col" data-rv={Math.min(i, 4) + 2}>
        <p class="years">{m.years}</p>
        <p class="text">{m.text}</p>
        <figure class:list={['pic', `g${m.gap}`]}>
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={m.figure}>
            {shapes(m.draw).map((s) => (
              <rect x={s.x.toFixed(1)} y={s.y.toFixed(1)} width={s.w.toFixed(1)} height={s.h.toFixed(1)} fill="currentColor" opacity={s.o.toFixed(2)} />
            ))}
          </svg>
          <figcaption>{m.figure}</figcaption>
        </figure>
      </li>
    ))}
  </ol>
</section>

<script>
  const row = document.querySelector<HTMLElement>('[data-path-row]');
  const bar = document.querySelector<HTMLElement>('[data-path-bar]');
  if (row && bar) {
    const update = () => {
      const max = row.scrollWidth - row.clientWidth;
      const p = max > 0 ? row.scrollLeft / max : 1;
      const visible = row.clientWidth / row.scrollWidth;
      bar.style.width = `${Math.max(visible, 0.08) * 100}%`;
      bar.style.transform = `translateX(${(p * (1 - visible) / Math.max(visible, 0.08)) * 100}%)`;
    };
    row.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
    const step = () => (row.querySelector<HTMLElement>('.col')?.offsetWidth ?? 300) + 32;
    document.querySelector('[data-path-prev]')?.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: 'smooth' }));
    document.querySelector('[data-path-next]')?.addEventListener('click', () => row.scrollBy({ left: step(), behavior: 'smooth' }));
  }
</script>

<style>
  .path { padding-top: var(--gap-section); }
  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .head { max-width: 16ch; }
  .nav-btns { display: flex; gap: 8px; }
  .sq {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 0;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .sq:hover { background: var(--surface-2); }
  .sq:active { transform: scale(0.94); }

  .progress { height: 6px; margin-top: 28px; background: var(--surface); overflow: hidden; }
  .progress span { display: block; height: 100%; width: 20%; background: var(--ink); transition: transform 120ms linear; }

  .row {
    display: flex;
    gap: 32px;
    margin: 40px var(--margin) 0;
    padding: 0 0 8px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .row::-webkit-scrollbar { display: none; }
  .row:focus-visible { outline-offset: -2px; }
  .col { flex: 0 0 300px; scroll-snap-align: start; display: flex; flex-direction: column; }
  .years { font-size: var(--step-body); font-weight: 500; }
  .text { margin-top: 8px; font-size: var(--step-body); line-height: 1.45; min-height: 6em; }
  .pic { margin: 0; color: color-mix(in srgb, var(--ink) 72%, var(--bg)); }
  .g80 { margin-top: 80px; } .g88 { margin-top: 88px; } .g96 { margin-top: 96px; } .g104 { margin-top: 104px; }
  .g120 { margin-top: 120px; } .g128 { margin-top: 128px; } .g136 { margin-top: 136px; }
  .pic svg { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; background: var(--surface); }
  .pic figcaption { margin-top: 12px; font-size: var(--step-lead); line-height: 1.25; letter-spacing: -0.01em; }

  @media (max-width: 899px) {
    .nav-btns { display: none; }
    .row { gap: 16px; }
    .col { flex-basis: 72vw; }
    .pic { margin-top: 40px; }
    .col:nth-child(2n) .pic { margin-top: 64px; }
  }
</style>
