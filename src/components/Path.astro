---
// Двадцать лет по резюме: строки «годы — текст», без рисунков и без горизонтальной прокрутки.
const moments = [
  { years: '2005–2010', text: 'Создал IT-подразделение и филиальную сеть: около десяти филиалов и больше двухсот рабочих мест в головном офисе.' },
  { years: '2010–2019', text: 'Корпоративная сеть и серверная с нуля (256 портов). Перевёл физические серверы в виртуализацию: VMware ESXi, затем Proxmox. Мониторинг на Zabbix, DNS, LDAP, почта.' },
  { years: '2019–2021', text: 'Перешёл в DevOps: сопровождение полного цикла разработки, поддержка инфраструктуры, мониторинг сервисов.' },
  { years: '2021–2022', text: 'Озеро данных на Arenadata Hadoop и ETL на Spark для банка из топ-5 России. DevOps-направление в департаменте данных с нуля.' },
  { years: 'С 2022 года', text: 'Выстроил DevOps в компании с нуля и создал DevOps-департамент. Kubernetes, GitLab CI и GitOps, VictoriaMetrics. Сократили парк на 300+ серверов.' },
  { years: 'Итог для бюджета', text: 'Расходы на инфраструктуру после сокращения парка ниже на 40–50%. Отвечаю за процессы, доставку и бюджет.' },
];
---
<section id="path" class="path wrap" data-reveal aria-labelledby="path-h">
  <h2 id="path-h" class="head" data-rv="0">Двадцать лет в&nbsp;инфраструктуре</h2>
  <ol class="rows">
    {moments.map((m, i) => (
      <li data-rv={Math.min(i + 1, 4)}>
        <span class="years">{m.years}</span>
        <p>{m.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .path { padding-top: var(--gap-section); }
  .rows { margin: 40px 0 0; padding: 0; list-style: none; display: grid; gap: 28px; }
  .rows li { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--margin); }
  .years { font-size: var(--step-lead); line-height: 1.3; }
  .rows p { max-width: 62ch; font-size: var(--step-body); line-height: 1.5; }

  @media (max-width: 899px) {
    .rows li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
