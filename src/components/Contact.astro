---
import { contactEmail } from '../lib/build';
---
<section id="contact" class="wrap section">
  <div class="box">
    <div>
      <h2 class="h2">Обсудим вашу систему</h2>
      <p class="intro">Опишите в паре абзацев, что за система и что беспокоит. Отвечу, могу ли помочь и с чего имеет смысл начать.</p>
    </div>
    <div class="actions">
      <a href="https://t.me/didaktik" class="btn btn-primary" target="_blank" rel="noopener">Написать в Telegram</a>
      <a href={`mailto:${contactEmail}`} class="btn">{contactEmail}</a>
    </div>
  </div>
</section>

<style>
  .box {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding: 48px;
    border-radius: 16px;
    background: var(--panel);
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; align-content: start; }
  @media (min-width: 960px) {
    .box { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: center; }
    .actions { justify-content: flex-end; }
  }
  @media (max-width: 767px) { .box { padding: 24px; } }
</style>
