---
import { contactEmail } from '../lib/build';

interface Props { n: number }
const { n } = Astro.props;
---
<section id="contact" class="wrap section doc">
  <div class="margin">
    <p><b>§{n}</b>связь</p>
  </div>
  <div class="main">
    <h2 class="h2">Расскажите, что за система и что в ней беспокоит</h2>
    <p class="intro">Пары абзацев достаточно, чтобы понять, могу ли я помочь. Удобнее всего в Telegram, почта тоже подойдёт.</p>
    <div class="actions">
      <a href="https://t.me/didaktik" class="btn btn-primary" target="_blank" rel="noopener">Написать в Telegram</a>
      <a href={`mailto:${contactEmail}`} class="link mono mail">{contactEmail}</a>
    </div>
  </div>
</section>

<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 32px; }
  .mail { color: var(--fg); }
</style>
