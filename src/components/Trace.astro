---
import { SPAN_ORDER, SPAN_META } from '../lib/trace';

const hops = [
  { id: 'browser', name: 'Ваш браузер' },
  { id: 'dns', name: 'DNS' },
  { id: 'caddy', name: 'Caddy: TLS, HSTS' },
  { id: 'astro', name: 'Контейнер: 0,5 CPU, 128 МБ' },
];
const first = SPAN_META.ttfb;
---
<figure class="trace" data-trace data-ui>
  <figcaption class="cap">
    <span class="what">Ваш запрос к&nbsp;этому сайту</span>
    <span class="src" data-trace-source>измеряю…</span>
  </figcaption>

  <p class="total"><span data-trace-total>—</span><span class="unit">мс</span></p>
  <p class="req">GET didaktik.dev{Astro.url.pathname}</p>

  <div class="spans" role="group" aria-label="Шаги загрузки страницы">
    {SPAN_ORDER.map((key) => (
      <button type="button" class="span" data-span={key} aria-pressed="false">
        <span class="label">{SPAN_META[key].name}</span>
        <span class="track" aria-hidden="true"><span class="bar"></span></span>
        <span class="ms" data-ms>—</span>
      </button>
    ))}
  </div>

  <div class="detail" aria-live="polite">
    <p class="name"><span data-detail-name>{first.name}</span> <span class="tag" data-detail-tag></span></p>
    <p class="text" data-detail-text>{first.text}</p>
  </div>

  <ol class="hops" aria-label="Путь запроса">
    {hops.map((h) => (
      <li class="hop" data-hop={h.id}>{h.name}</li>
    ))}
  </ol>

  <noscript><p class="text">Тайминги берутся из вашего браузера, для этого нужен JavaScript.</p></noscript>
</figure>

<script>
  import { SPAN_META, fmtMs, whenTraceReady, type SpanKey, type Trace } from '../lib/trace';

  const root = document.querySelector<HTMLElement>('[data-trace]');
  if (root) {
    const rows = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-span]'));
    const hopEls = Array.from(root.querySelectorAll<HTMLElement>('[data-hop]'));
    const nameEl = root.querySelector<HTMLElement>('[data-detail-name]')!;
    const textEl = root.querySelector<HTMLElement>('[data-detail-text]')!;
    const tagEl = root.querySelector<HTMLElement>('[data-detail-tag]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-trace-total]')!;
    let trace: Trace | null = null;

    const select = (key: SpanKey) => {
      for (const row of rows) {
        const on = row.dataset.span === key;
        row.classList.toggle('is-active', on);
        row.setAttribute('aria-pressed', String(on));
      }
      const meta = SPAN_META[key];
      for (const hop of hopEls) hop.classList.toggle('is-on', meta.hops.includes(hop.dataset.hop!));
      nameEl.textContent = meta.name;
      textEl.textContent = meta.text;
      if (trace) {
        const span = trace.spans.find((s) => s.key === key)!;
        const slow = key === trace.slowest;
        tagEl.textContent = slow ? `${fmtMs(span.duration)}, самый долгий шаг` : fmtMs(span.duration);
        tagEl.classList.toggle('is-slow', slow);
      }
    };

    for (const row of rows) {
      const key = row.dataset.span as SpanKey;
      row.addEventListener('focus', () => select(key));
      row.addEventListener('click', () => select(key));
    }

    // Счётчик итога: один раз, от нуля до значения
    const count = (to: number) => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { totalEl.textContent = String(to); return; }
      const t0 = performance.now();
      const dur = 700;
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        totalEl.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 4))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    whenTraceReady((t) => {
      trace = t;
      count(Math.round(t.total));
      root.querySelector<HTMLElement>('[data-trace-source]')!.textContent = t.real
        ? 'измерено в вашем браузере'
        : 'пример: браузер не отдал тайминги';
      t.spans.forEach((span, i) => {
        const row = rows.find((r) => r.dataset.span === span.key)!;
        const bar = row.querySelector<HTMLElement>('.bar')!;
        bar.style.left = `${(span.start / t.total) * 100}%`;
        bar.style.width = `${Math.max((span.duration / t.total) * 100, 1)}%`;
        bar.style.animationDelay = `${i * 90}ms`;
        bar.classList.toggle('is-slow', span.key === t.slowest);
        row.querySelector<HTMLElement>('[data-ms]')!.textContent = fmtMs(span.duration);
      });
      root.classList.add('is-ready');
      select(t.slowest);
    });
  }
</script>

<style>
  .trace {
    margin: 0;
    padding: 28px;
    background: var(--bg);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .cap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; font-size: 16px; line-height: 24px; }
  .what { font-weight: 500; }
  .src { color: var(--muted); }

  .total {
    margin: 24px 0 0;
    font-size: clamp(64px, 7vw, 112px);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .unit { margin-left: 0.18em; font-size: 0.32em; letter-spacing: 0; color: var(--muted); }
  .req { margin: 12px 0 0; font-size: 15px; line-height: 22px; color: var(--muted); overflow-wrap: anywhere; }

  .spans { display: flex; flex-direction: column; margin: 24px -10px 0; }
  .span {
    display: grid;
    grid-template-columns: minmax(0, 150px) minmax(0, 1fr) 72px;
    gap: 16px;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: 0 10px;
    border: 0;
    background: transparent;
    text-align: left;
    font-size: 15px;
    line-height: 20px;
    cursor: pointer;
    transition: background-color var(--t-hover) ease;
  }
  .span:hover, .span.is-active { background: var(--surface); }
  .label { color: var(--muted); transition: color var(--t-hover) ease; }
  .span.is-active .label, .span:hover .label { color: var(--ink); }
  .ms { text-align: right; }

  .track { position: relative; height: 12px; background: var(--surface); }
  .span.is-active .track, .span:hover .track { background: var(--surface-2); }
  .bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 12px;
    background: var(--muted);
    transform-origin: left center;
  }
  .bar.is-slow { background: var(--accent); }
  .is-ready .bar { animation: grow 0.8s var(--ease-expo) both; }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .detail { min-height: 112px; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--ui-line); } /* taste-skill-ignore: интерфейсный фрагмент data-ui */
  .name { font-size: 16px; line-height: 24px; font-weight: 500; }
  .tag { margin-left: 8px; font-weight: 400; color: var(--muted); }
  .tag.is-slow { color: var(--ink); font-weight: 500; }
  .text { margin-top: 6px; font-size: 15px; line-height: 22px; color: var(--muted); max-width: 54ch; }

  .hops { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; padding: 0; list-style: none; }
  .hop {
    padding: 8px 12px;
    border: 1px solid var(--ui-line); /* taste-skill-ignore: интерфейсный фрагмент data-ui */
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
    transition: border-color var(--t-ui) ease, color var(--t-ui) ease, background-color var(--t-ui) ease;
  }
  .hop.is-on { border-color: var(--accent); color: var(--ink); }

  @media (max-width: 640px) {
    .trace { padding: 20px 16px; }
    .span { grid-template-columns: minmax(0, 104px) minmax(0, 1fr) 60px; gap: 10px; font-size: 14px; }
    .total { margin-top: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .is-ready .bar { animation: none; } }
</style>
