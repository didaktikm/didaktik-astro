---
// Направления работы. ref указывает на номер находки в аудите этого сайта (src/data/audit.ts).
const items = [
  {
    title: 'Аудит платформ',
    text: 'Сверяю, что платформа делает, с тем, что про неё написано, и считаю цену каждого расхождения: часы простоя, деньги, риск. Отчёт заканчивается списком исправлений, самые дорогие сверху.',
    io: 'вход: доступ на чтение · выход: находка, доказательство, цена исправления',
    ref: 2,
  },
  {
    title: 'Безопасность данных и ИИ-агентов',
    text: 'Клиентская выгрузка лежит в рабочей папке, в той же IDE работает ИИ-ассистент. Утечке не нужен злой умысел. Нахожу пути, по которым данные могут уйти, и закрываю их правами, политиками и журналом действий. Агент получает ровно тот доступ, который нужен задаче.',
    io: 'вход: карта потоков данных и доступов · выход: политики, права, секреты, журнал',
    ref: 6,
  },
  {
    title: 'DevOps и эксплуатация',
    text: 'Сборка, доставка, наблюдаемость. Откат, проверенный на практике. Алерт, который срабатывает раньше, чем позвонит пользователь.',
    io: 'вход: текущий пайплайн · выход: воспроизводимый деплой, SLO, runbook',
    ref: 3,
  },
  {
    title: 'Архитектура',
    text: 'Решения, которые через полгода можно объяснить и проверить. Для каждого записываем, какую метрику оно должно сдвинуть и по какому признаку станет понятно, что мы ошиблись.',
    io: 'вход: требования и ограничения · выход: схема границ, ADR, критерий успеха',
    ref: null,
  },
];
---
<section id="work" class="wrap section doc">
  <div class="margin">
    <p><b>§1</b>работа</p>
    <p>Ссылки ведут на находки из аудита этого сайта.</p>
  </div>
  <div class="main">
    <h2 class="h2">С чем ко мне приходят</h2>
    <p class="intro">По каждой работе фиксируем цифру до начала и цифру после. Пока второй цифры нет, работа не закончена.</p>
    <ol class="list">
      {items.map((it) => (
        <li class="item">
          <h3>{it.title}</h3>
          <div class="body">
            <p class="text">{it.text}</p>
            <p class="mono io">
              {it.io}
              {it.ref && <> · <a class="ref" href={`#f${it.ref}`}>пример: находка {it.ref}</a></>}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .list { list-style: none; margin: 48px 0 0; padding: 0; }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    padding: 24px 0;
    border-top: 1px solid var(--line-soft);
  }
  h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 28px;
    margin: 0;
    text-wrap: balance;
  }
  .text { font-size: 16px; line-height: 24px; color: var(--muted); margin: 0; max-width: 62ch; }
  .io { margin: 12px 0 0; color: var(--faint); }
  .ref { color: var(--teal); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .ref:hover { color: var(--teal-hover); }
  @media (min-width: 768px) {
    .item { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 32px; }
  }
</style>
