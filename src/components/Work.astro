---
const items = [
  {
    title: 'Аудит платформ',
    text: 'Проверяю, что платформа делает то, что заявлено, и переживёт плохой день: падение узла, протухший сертификат, откат в пятницу вечером.',
    io: 'репозитории и доступ на чтение → отчёт с доказательствами',
  },
  {
    title: 'Архитектура',
    text: 'Решения, которые можно объяснить через полгода. Короткие записи о контексте, выборе и цене выбора.',
    io: 'требования и ограничения → схема границ и ADR',
  },
  {
    title: 'DevOps и эксплуатация',
    text: 'Сборка, доставка, наблюдаемость. Откат, который работает, и алерт, который будит до звонка пользователя.',
    io: 'текущий пайплайн → воспроизводимый деплой и runbook',
  },
];
---
<section id="work" class="wrap section">
  <p class="eyebrow">Чем занимаюсь</p>
  <h2 class="h2 heading">Три вида работы, один подход: сначала измерить.</h2>
  <div class="work">
    {items.map((it) => (
      <article>
        <h3>{it.title}</h3>
        <p class="text">{it.text}</p>
        <p class="mono io">{it.io}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .heading { max-width: 24ch; }
  .work { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 36px; border-top: 1px solid var(--line); }
  article { padding: 28px 28px 28px 0; min-width: 0; }
  article + article { padding-left: 28px; border-left: 1px solid var(--line); }
  h3 { font-size: 19px; font-weight: 600; margin: 0; }
  .text { font-size: 15px; line-height: 1.65; color: var(--muted); margin: 12px 0 18px; }
  .io { margin: 0; line-height: 1.7; }
  @media (max-width: 860px) {
    .work { grid-template-columns: minmax(0, 1fr); }
    article, article + article { padding: 24px 0; border-left: 0; }
    article + article { border-top: 1px solid var(--line); }
  }
</style>
