---
import { getCollection } from 'astro:content';
import { buildSha } from '../lib/build';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((n) => ({ id: n.id, title: n.data.title, date: n.data.date.toISOString().slice(0, 10) }));
---
<section
  id="console"
  class="sheet"
  role="dialog"
  aria-label="Консоль"
  hidden
  data-console
  data-notes={JSON.stringify(notes)}
  data-build={buildSha}
  data-ui
>
  <div class="bar">
    <span class="mono"><span class="dot" aria-hidden="true">●</span> didaktik shell 0.4<span class="wide"> · guest@didaktik.dev</span></span>
    <button type="button" class="close mono" data-console-close aria-label="Закрыть консоль"><span class="wide">esc · </span>закрыть</button>
  </div>
  <div class="log" role="log" aria-live="polite" data-console-log></div>
  <form class="line" data-console-form autocomplete="off">
    <label for="console-input" class="visually-hidden">Команда</label>
    <span class="ps" aria-hidden="true">$</span>
    <input id="console-input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="help" data-console-input />
  </form>
  <div class="chips" data-console-chips>
    {['top', 'trace', 'curl -I', 'ping', 'slo 99.95', 'kubectl get pods', 'agent run "почини прод"', 'nvidia-smi', 'incident', 'help'].map((c) => (
      <button type="button" class="chip mono" data-cmd={c}>{c}</button>
    ))}
  </div>
</section>

<script>
  import { Aborted, type Ctx, type Line, type LiveBlock } from '../scripts/console/types';

  // Команды грузятся лениво: при первом открытии или наведении на кнопку
  type Registry = typeof import('../scripts/console/index');
  let registry: Registry | null = null;
  let loading: Promise<Registry> | null = null;
  const loadRegistry = () => (loading ??= import('../scripts/console/index').then((m) => (registry = m)));

  const sheet = document.querySelector<HTMLElement>('[data-console]');
  const launcher = document.querySelector<HTMLButtonElement>('[data-console-open]');
  if (sheet && launcher) {
    const log = sheet.querySelector<HTMLElement>('[data-console-log]')!;
    const form = sheet.querySelector<HTMLFormElement>('[data-console-form]')!;
    const input = sheet.querySelector<HTMLInputElement>('[data-console-input]')!;
    const openers = Array.from(document.querySelectorAll<HTMLElement>('[data-console-open]'));
    const notes = JSON.parse(sheet.dataset.notes || '[]');
    const buildSha = sheet.dataset.build || 'local';
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const history: string[] = [];
    let cursor = 0;
    let running: AbortController | null = null;
    let returnFocus: HTMLElement | null = null;
    let greeted = false;

    // Экранная клавиатура iOS не меняет layout viewport: поднимаем панель над ней
    const vv = window.visualViewport;
    if (vv) {
      const fit = () => {
        const kb = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
        sheet.style.bottom = `${kb}px`;
        sheet.style.maxHeight = `${Math.round(vv.height * 0.9)}px`;
      };
      vv.addEventListener('resize', fit);
      vv.addEventListener('scroll', fit);
    }

    const lineEl = (l: Line) => {
      const div = document.createElement('div');
      div.className = `ln ${l.level}`;
      div.textContent = l.text || ' ';
      return div;
    };

    const scroll = () => { log.scrollTop = log.scrollHeight; };

    const print = (lines: Line[]) => {
      for (const l of lines) log.appendChild(lineEl(l));
      while (log.childElementCount > 400) log.firstElementChild?.remove();
      scroll();
    };

    const live = (): LiveBlock => {
      const box = document.createElement('div');
      box.className = 'live';
      log.appendChild(box);
      return {
        set(lines) {
          box.replaceChildren(...lines.map(lineEl));
          // Высокий блок (top) держим верхом в кадре, чтобы шапка не уезжала
          log.scrollTop = box.offsetHeight > log.clientHeight ? box.offsetTop : log.scrollHeight;
        },
      };
    };

    const setExpanded = (v: boolean) => openers.forEach((o) => o.setAttribute('aria-expanded', String(v)));

    const open = () => {
      loadRegistry();
      if (!sheet.hidden) { input.focus(); return; }
      returnFocus = document.activeElement as HTMLElement | null;
      sheet.hidden = false;
      document.body.classList.add('console-open');
      setExpanded(true);
      if (!greeted) {
        print([
          { text: 'didaktik shell 0.4. Введите help или выберите подсказку ниже.', level: 'info' },
          { text: 'Часть команд работает по-настоящему: curl, ping, top, ls /, slo.', level: 'muted' },
        ]);
        greeted = true;
      }
      input.focus();
    };

    const close = () => {
      if (sheet.hidden) return;
      running?.abort();
      sheet.hidden = true;
      document.body.classList.remove('console-open');
      setExpanded(false);
      (returnFocus && document.contains(returnFocus) ? returnFocus : launcher).focus();
    };

    const clear = () => { log.textContent = ''; };

    const setBusy = (busy: boolean) => {
      sheet.classList.toggle('is-busy', busy);
      input.placeholder = busy ? 'q или Ctrl+C: прервать' : 'help';
    };

    const run = async (raw: string) => {
      const text = raw.trim();
      if (!text || running) return;
      history.push(text);
      cursor = history.length;
      print([{ text: `$ ${text}`, level: 'muted' }]);

      let reg: Registry;
      try {
        reg = await loadRegistry();
      } catch {
        loading = null;
        print([{ text: 'консоль: не удалось загрузить команды. Проверьте сеть и повторите.', level: 'err' }]);
        return;
      }

      const egg = reg.special(text);
      if (egg) { print(egg); return; }

      const [name, ...args] = text.split(/\s+/);
      const cmd = reg.resolve(name);
      if (!cmd) {
        print([{ text: `${name}: команда не найдена. Попробуйте help.`, level: 'err' }]);
        return;
      }

      const ac = new AbortController();
      running = ac;
      setBusy(true);
      const ctx: Ctx = {
        raw: text,
        notes,
        history,
        buildSha,
        signal: ac.signal,
        print,
        live,
        clear,
        close,
        sleep: (ms) =>
          new Promise<void>((resolveSleep, reject) => {
            if (ac.signal.aborted) return reject(new Aborted());
            const t = setTimeout(resolveSleep, reduceMotion ? Math.min(ms, 120) : ms);
            ac.signal.addEventListener('abort', () => { clearTimeout(t); reject(new Aborted()); }, { once: true });
          }),
      };

      try {
        const result = await cmd.run(args, ctx);
        if (result && !ac.signal.aborted) print(result);
      } catch (err) {
        if (err instanceof Aborted || (err instanceof DOMException && err.name === 'AbortError') || ac.signal.aborted) {
          print([{ text: '^C', level: 'muted' }]);
        } else {
          print([{ text: `${name}: что-то пошло не так. Это тоже инцидент.`, level: 'err' }]);
        }
      } finally {
        running = null;
        setBusy(false);
      }
    };

    openers.forEach((o) => {
      o.addEventListener('click', open);
      o.addEventListener('pointerenter', () => { loadRegistry(); }, { once: true });
      o.addEventListener('focus', () => { loadRegistry(); }, { once: true });
    });
    sheet.querySelector('[data-console-close]')!.addEventListener('click', close);
    sheet.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) =>
      b.addEventListener('click', () => {
        if (running) return;
        run(b.dataset.cmd!);
        input.focus();
      }),
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (running) return;
      const v = input.value;
      input.value = '';
      run(v);
    });

    input.addEventListener('keydown', (e) => {
      if (running) {
        if ((e.ctrlKey && e.key.toLowerCase() === 'c') || e.key === 'q') {
          e.preventDefault();
          running.abort();
        }
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        cursor = Math.max(0, cursor - 1);
        input.value = history[cursor] ?? '';
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        cursor = Math.min(history.length, cursor + 1);
        input.value = history[cursor] ?? '';
      } else if (e.key === 'Tab') {
        const v = input.value.trim().toLowerCase();
        if (!v || v.includes(' ')) return;
        e.preventDefault();
        const m = (registry?.VISIBLE_NAMES ?? []).filter((c) => c.startsWith(v));
        if (m.length === 1) input.value = `${m[0]} `;
        else if (m.length > 1) print([{ text: m.join('   '), level: 'info' }]);
      } else if (e.ctrlKey && e.key.toLowerCase() === 'l') {
        e.preventDefault();
        clear();
      } else if (e.ctrlKey && e.key.toLowerCase() === 'c') {
        e.preventDefault();
        input.value = '';
        print([{ text: '^C', level: 'muted' }]);
      }
    });

    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement | null;
      const typing = !!t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        sheet.hidden ? open() : close();
      } else if (e.key === 'Escape' && !sheet.hidden) {
        e.preventDefault();
        if (running) running.abort();
        else close();
      } else if (e.key === '/' && !typing && sheet.hidden) {
        e.preventDefault();
        open();
      }
    });
  }
</script>

<style>
  /* Консоль: интерфейсный фрагмент (data-ui), у него свои линии и моноширинный шрифт */
  .sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    height: min(500px, 75vh);
    height: min(500px, 75dvh);
    max-width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px max(var(--margin), env(safe-area-inset-right, 0px)) max(14px, env(safe-area-inset-bottom, 0px)) max(var(--margin), env(safe-area-inset-left, 0px));
    background: var(--surface);
    color: var(--ink);
    border-top: 2px solid var(--accent);
    box-shadow: 0 -24px 64px rgb(0 0 0 / 0.35); /* taste-skill-ignore: интерфейсный фрагмент data-ui */
    animation: rise 0.28s var(--ease-out);
  }
  .sheet[hidden] { display: none; }
  @keyframes rise { from { transform: translateY(24px); opacity: 0.4; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .sheet { animation: none; } }

  .bar { flex: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; font-family: var(--mono); font-size: 12px; color: var(--muted); } /* taste-skill-ignore: интерфейсный фрагмент data-ui */
  .dot { color: var(--accent); }
  .is-busy .dot { color: var(--ui-warn); animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0.3; } }
  .close {
    flex: none;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--ui-line); /* taste-skill-ignore: интерфейсный фрагмент data-ui */
    background: transparent;
    font-family: var(--font);
    font-size: 15px;
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--t-hover) ease;
  }
  .close:hover { border-color: var(--accent); }

  .log {
    position: relative;
    min-width: 0;
    overscroll-behavior: contain;
    flex: 1;
    min-height: 0;
    overflow: auto;
    font-family: var(--mono); /* taste-skill-ignore: интерфейсный фрагмент data-ui */
    font-size: 12.5px;
    line-height: 1.75;
    font-variant-numeric: tabular-nums;
  }
  .log :global(.ln) { white-space: pre; color: var(--ink); }
  .log :global(.ln.info), .log :global(.ln.ok) { color: var(--accent); }
  .log :global(.ln.warn) { color: var(--ui-warn); }
  .log :global(.ln.err) { color: var(--ui-err); }
  .log :global(.ln.muted) { color: var(--muted); }

  .line { flex: none; display: flex; align-items: center; gap: 12px; padding-top: 10px; border-top: 1px solid var(--ui-line); } /* taste-skill-ignore: интерфейсный фрагмент data-ui */
  .ps { font-family: var(--mono); color: var(--accent); } /* taste-skill-ignore: интерфейсный фрагмент data-ui */
  input {
    flex: 1;
    min-width: 0;
    min-height: 40px;
    border: 0;
    outline: none;
    background: none;
    font-family: var(--mono); /* taste-skill-ignore: интерфейсный фрагмент data-ui */
    font-size: 14px;
    color: var(--ink);
  }
  input::placeholder { color: var(--muted); }

  .chips { flex: none; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    flex: none;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--ui-line); /* taste-skill-ignore: интерфейсный фрагмент data-ui */
    background: transparent;
    font-family: var(--mono); /* taste-skill-ignore: интерфейсный фрагмент data-ui */
    font-size: 12px;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .chip:hover { border-color: var(--accent); color: var(--ink); }
  .is-busy .chip { opacity: 0.5; pointer-events: none; }
  :global(body.console-open) { overflow: hidden; }

  @media (max-width: 640px) {
    .wide { display: none; }
    .log { font-size: 11.5px; overflow-x: hidden; overflow-y: auto; }
    /* 16px: иначе iOS Safari приближает страницу при фокусе на поле */
    input { font-size: 16px; }
    .log :global(.ln) { white-space: pre-wrap; overflow-wrap: anywhere; }
  }
</style>
